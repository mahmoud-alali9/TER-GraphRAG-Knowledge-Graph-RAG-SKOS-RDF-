    :heightMin "5.0"^^xsd:decimal ;
    :areaMin "0.1"^^xsd:decimal ;
    :sourceRef "http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" ;
    :definitionText "(Latvia 2010 KP) Crown cover > 20%, tree height > 5m, area > 0.1 ha. http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" .

:def_Forest_Latvia_nd_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Latvia ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :heightMin "7.0"^^xsd:decimal ;
    :sourceRef "http://www.metla.fi/eu/cost/e43/minutes/wg1-min-florence.pdf" ;
    :definitionText "(Latvia) Forest -National definition in use: crown cover 20 %, 7 m height limit http://www.metla.fi/eu/cost/e43/minutes/wg1-min-florence.pdf" .

:def_Forest_Lebanon_nd_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Lebanon ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :heightMin "5.0"^^xsd:decimal ;
    :areaMin "0.5"^^xsd:decimal ;
    :sourceRef "http://www.capeaction.org.za/uploads/BD_in_SEA_manual.pdf" ;
    :definitionText "(Lebanon) Forest refer to forest land spanning more than 0.5 hectares with trees higher than 5 meters and a canopy cover of more than 10%, or trees able to reach these threshold in situ. It does not include land that is predominantly under agricultural or urban land use. http://www.capeaction.org.za/uploads/BD_in_SEA_manual.pdf" .

:def_Forest_Liechtenstein_1997_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Liechtenstein ;
    dcterms:date "1997"^^xsd:gYear ;
    :canopyThreshold "100.0"^^xsd:decimal ;
    :definitionText "(Liechtenstein 1997) - Focuses on growing stock and applies to measurable criteria - width of forest area, crown closure and top height. Width of growing stock with canopy closure = 100% is at least 25 m and with crown closure = 20% at least 50 m. Canopy closure between 20 % and 100 % depending on width of growing stock. Minimum top diameter 3 m (exceptions afforestation, young growth, mountain alder, mountain pine) (European Communities 1997b - p. 1067)" .

:def_Forest_Liechtenstein_2000_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Liechtenstein ;
    dcterms:date "2000"^^xsd:gYear ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :areaMin "0.0625"^^xsd:decimal ;
    :sourceRef "http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" ;
    :definitionText "(Liechtenstein 2000) Minimum area of land: 0.0625 ha (with a minimum width of 25 m), minimum crown cover: 20%, minimum height of the dominant trees: 3 m (dominant trees must have the potential to reach, 3 m at maturity in situ). Amt für Wald, Natur und Landschaft (AWNL), 2000. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" .

:def_Forest_Lithuania_2009_001
    rdf:type :Definition ;
