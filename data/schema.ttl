    :areaMin "25.0"^^xsd:decimal ;
    :sourceRef "http://www.fs.fed.us/research/sustain/2003SustainabilityReport/documents/SustainableForests.pdf" ;
    :definitionText "(Mexico 2003) Minimum area = 25 ha, minimum tree crown cover =10%, minimum tree height = 3 m. http://www.fs.fed.us/research/sustain/2003SustainabilityReport/documents/SustainableForests.pdf" .

:def_Forest_Mexico_2005_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Mexico ;
    dcterms:date "2005"^^xsd:gYear ;
    :heightMin "2.0"^^xsd:decimal ;
