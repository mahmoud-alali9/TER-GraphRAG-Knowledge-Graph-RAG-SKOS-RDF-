    :canopyThreshold "30.0"^^xsd:decimal ;
    :areaMin "0.05"^^xsd:decimal ;
    :sourceRef "http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" ;
    :definitionText "(Austria 2001) Minimum area: 0.05 ha; Minimum width: 10 m; The cultural type registered in the land register is insignificant; minimum crown coverage of 30 % (occular estimation). Schieler and Hauk 2001. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" .

:def_Forest_Austria_2006_001
    rdf:type :Definition ;
    :defines :Forest ;
