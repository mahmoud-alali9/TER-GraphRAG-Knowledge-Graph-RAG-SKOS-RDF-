@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix :        <http://example.org/forest#> .


# ══════════════════════════════════════════════════════════
# SCHEMA — Classes
# ══════════════════════════════════════════════════════════

:Definition rdf:type rdfs:Class ;
    rdfs:label "Definition" ;
    rdfs:comment "A normative definition from a specific jurisdiction" .

:Jurisdiction rdf:type rdfs:Class ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "An institutional or geographical entity that authored a definition" .

:JurisdictionLevel rdf:type rdfs:Class ;
    rdfs:label "JurisdictionLevel" ;
    rdfs:comment "Scale at which a definition was produced (General, International, National, Local)" .

:InterpretationCategory rdf:type rdfs:Class ;
    rdfs:label "InterpretationCategory" ;
    rdfs:comment "Angle under which the term is defined (Administrative, LandCover, LandUse, Ecological)" .

# ══════════════════════════════════════════════════════════
# SCHEMA — Properties
# ══════════════════════════════════════════════════════════

:defines rdf:type rdf:Property ;
    rdfs:comment "Links a Definition to the Concept it defines" .

:appliesIn rdf:type rdf:Property ;
    rdfs:comment "Links a Definition to its Jurisdiction" .

:hasJurisdictionLevel rdf:type rdf:Property ;
    rdfs:comment "Links a Definition to its JurisdictionLevel" .

:hasCategory rdf:type rdf:Property ;
    rdfs:comment "Links a Definition to its InterpretationCategory" .

:canopyThreshold rdf:type rdf:Property ;
    rdfs:comment "Minimum canopy/crown cover percentage" .

:heightMin rdf:type rdf:Property ;
    rdfs:comment "Minimum tree height in meters" .

:areaMin rdf:type rdf:Property ;
    rdfs:comment "Minimum area in hectares" .

:definitionText rdf:type rdf:Property ;
    rdfs:comment "Full text of the definition" .

:sourceRef rdf:type rdf:Property ;
    rdfs:comment "Source reference: URL, email, or author name" .

# ══════════════════════════════════════════════════════════
# SKOS Concepts
# ══════════════════════════════════════════════════════════

:Forest
    rdf:type skos:Concept ;
    skos:prefLabel "Forest"@en .

:Tree
    rdf:type skos:Concept ;
    skos:prefLabel "Tree"@en .

:Afforestation
    rdf:type skos:Concept ;
    skos:prefLabel "Afforestation"@en .

:Deforestation
    rdf:type skos:Concept ;
    skos:prefLabel "Deforestation"@en .

:Reforestation
    rdf:type skos:Concept ;
    skos:prefLabel "Reforestation"@en .

# ══════════════════════════════════════════════════════════
# Jurisdiction Levels
# ══════════════════════════════════════════════════════════

:General
    rdf:type :JurisdictionLevel ;
    rdfs:label "General" ;
    rdfs:comment "Definitions from dictionaries, textbooks, or individual authors" .

:International
    rdf:type :JurisdictionLevel ;
    rdfs:label "International" ;
    rdfs:comment "Definitions from international organisations (FAO, IPCC, World Bank, etc.)" .

:National
    rdf:type :JurisdictionLevel ;
    rdfs:label "National" ;
    rdfs:comment "Definitions from national legislation" .

:Local
    rdf:type :JurisdictionLevel ;
    rdfs:label "Local" ;
    rdfs:comment "Definitions from sub-national authorities (states, provinces, regions)" .

# ══════════════════════════════════════════════════════════
# Interpretation Categories
# ══════════════════════════════════════════════════════════

:Administrative
    rdf:type :InterpretationCategory ;
    rdfs:label "Administrative" ;
    rdfs:comment "Forest defined as a legal or institutional status" .

:LandCover
    rdf:type :InterpretationCategory ;
    rdfs:label "LandCover" ;
    rdfs:comment "Forest defined by observable physical characteristics (canopy cover, tree height, minimum area)" .

:LandUse
    rdf:type :InterpretationCategory ;
    rdfs:label "LandUse" ;
    rdfs:comment "Forest defined by its human function or intended purpose" .

:LandCoverUse
    rdf:type :InterpretationCategory ;
    rdfs:label "LandCoverUse" ;
    rdfs:comment "Forest defined by both land cover and land use characteristics" .

:Ecological
    rdf:type :InterpretationCategory ;
    rdfs:label "Ecological" ;
    rdfs:comment "Forest defined as an integrated ecosystem" .

:Other
    rdf:type :InterpretationCategory ;
    rdfs:label "Other" ;
    rdfs:comment "Definitions not fitting standard categories" .

