:def_Forest_Bulgaria_2001_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Bulgaria ;
    dcterms:date "2001"^^xsd:gYear ;
    :sourceRef "http://www.iufro.org/download/file/5574/4510/61300-jundola01_pdf/" ;
    :definitionText "(Bulgaria 2001) Forest\" is defined as any land exceeding 1 decare, covered or planted with forest trees or brushwood and located outside the boundaries of settlements (sec. 3). However, single trees in farmlands, afforested areas adjacent to monuments, forest belts on lands within cooperative and state farms, and forest stands planted by enterprises, organizations or cooperatives on their lands, are not part of the national forest stock (sec. 4). http://www.iufro.org/download/file/5574/4510/6130" .

:def_Forest_Bulgaria_2007_001
    rdf:type :Definition ;
