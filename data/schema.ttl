    :sourceRef "http://www.intnet.mu/iels/Forest_act_1983.htm" ;
    :definitionText "(Mauritius 1983) - Includes a national forest and all land which is not under cultivation and which is covered by trees (The Forests and Reserves Act 1983 - http://www.intnet.mu/iels/Forest_act_1983.htm" .

:def_Forest_Mexico_SARH_1994_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Mexico_SARH ;
    dcterms:date "1994"^^xsd:gYear ;
    :definitionText "(Mexico – SARH 1994) (Arbolado). Los terrenos ar bolados enlosques las copas de los arboles cubren mas del 20% de la superficie (SARH 1994)" .

:def_Forest_Mexico_SARH_1994_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Mexico_SARH ;
    dcterms:date "1994"^^xsd:gYear ;
    :definitionText "(Mexico - SARH 1994) (Area forestall). Terrenos cuyas caracteristics topograficas y condiciones ecologicas, permiten que sustente como forma optima de uso del suelo a la vegetacion arborea, ar bustiva o her bacea natural (SARH 1994)." .

:def_Forest_Mexico_SARH_1994_003
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Mexico_SARH ;
    dcterms:date "1994"^^xsd:gYear ;
    :definitionText "(Mexico – SARH 1994) (Bosque). Comunidad vegetal en la que prodominan los arboles y otras especies lenosas. (SARH 1994)." .

:def_Forest_Mexico_2003_001
    rdf:type :Definition ;
    :defines :Forest ;
