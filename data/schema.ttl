    :definitionText "(Luxembourg 2006 KP) Cover Min. Area (ha) = 0.5 Min. Crown Cover (%) = 10 Min. Tree Height (m) = 5 Min. Strip Width (m) = ns http://unfccc.int/files/national_reports/initial_reports_under_the_kyoto_protocol/application/pdf/mev_initial_report_0612.pdf (2006)" .

:def_Forest_Luxembourg_2009_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Luxembourg ;
    dcterms:date "2009"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :heightMin "5.0"^^xsd:decimal ;
