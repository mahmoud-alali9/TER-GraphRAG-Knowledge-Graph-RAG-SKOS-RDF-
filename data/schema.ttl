    :definitionText "(Austria 2006 KP) Cover Min. Area (ha) = 0.05 Min. Crown Cover (%) = 30 Min. Tree Height (m) = 2 Min. Strip Width (m) = 10 http://unfccc.int/files/national_reports/initial_reports_under_the_kyoto_protocol/application/pdf/at-initial-report-200611-corr.pdf (2006)" .

:def_Forest_Austria_2009_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Austria ;
