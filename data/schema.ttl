    :heightMin "5.0"^^xsd:decimal ;
    :areaMin "0.1"^^xsd:decimal ;
    :sourceRef "http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" ;
    :definitionText "(Lithuania 2009 NIR) Tree height > 5m, area > 0.1 ha. http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" .

:def_Forest_Lithuania_2013_001
    rdf:type :Definition ;
    :defines :Forest ;
