:def_Forest_Sri_Lanka_2006_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sri_Lanka ;
    dcterms:date "2006"^^xsd:gYear ;
    :canopyThreshold "30.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :areaMin "0.05"^^xsd:decimal ;
    :sourceRef "http://cdm.unfccc.int/DNA/index.html" ;
    :definitionText "(Sri Lanka 2006 KP) Cover Min. Area (ha) = 0.05 Min. Crown Cover (%) = 30 Min. Tree Height (m) = 3 Min. Strip Width (m) = ns http://cdm.unfccc.int/DNA/index.html" .

:def_Forest_Sri_Lanka_2010_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sri_Lanka ;
    dcterms:date "2010"^^xsd:gYear ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :areaMin "0.05"^^xsd:decimal ;
    :sourceRef "http://www.forestcarbonasia.org/wp-content/uploads/2011/06/Sri-Lanka-Country-Report-final-02.06.2011.pdf" ;
    :definitionText "(Sri Lanka 2010 KP) is now defined as follows: a minimum land area of 0.05 hectares with a minimum tree canopy cover of 20% and a canopy height of 3 m. The definition does not specify whether species such as rubber, bamboo and palm trees are included. http://www.forestcarbonasia.org/wp-content/uploads/2011/06/Sri-Lanka-Country-Report-final-02.06.2011.pdf and https://cdm.unfccc.int/DNA/DNA/allCountriesARInfos.html" .

:def_Forest_St_Lucia_nd_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :St_Lucia ;
    :sourceRef "chiefforest@maffe.org" ;
    :definitionText "(St. Lucia) - Timber lands/Forest lands - Lands whereon trees are growing and which are not permanent agriculture cultivation. (Source: Michael Andrew, chiefforest@maffe.org)" .

:def_Forest_St_Lucia_nd_003
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :St_Lucia ;
    :sourceRef "chiefforest@maffe.org" ;
    :definitionText "(St. Lucia) Any area of land covered in trees usually of various ages, mixed or single species as in forest plantations. (Source: Michael Andrew, chiefforest@maffe.org)" .

:def_Forest_Sudan_1970_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sudan ;
    dcterms:date "1970"^^xsd:gYear ;
    :sourceRef "http://postconflict.unep.ch/publications/sudan/09_forests.pdf" ;
    :definitionText "(Sudan 1970) forests and woodlands as ‘any area of vegetation dominated by trees of any size’. http://postconflict.unep.ch/publications/sudan/09_forests.pdf" .

:def_Forest_Sudan_nd_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sudan ;
    :canopyThreshold "40.0"^^xsd:decimal ;
    :heightMin "10.0"^^xsd:decimal ;
    :definitionText "(Sudan). Min. av. height 10 m. Canopy closure 40 %. Source: ECE-FAO Partnership Programme: Kenya Workshop on Forestry Statistics. Appendix 6." .

:def_Forest_Swazi_Nation_1910_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Swazi_Nation ;
    dcterms:date "1910"^^xsd:gYear ;
    :definitionText "(Swazi Nation -1910) \"private forest\" means a forest, plantation or tree situate on land not owned by the Government, or on Swazi nation land; www.sntc.org.sz/documents/ForestPreservationAct.do" .

:def_Forest_Swaziland_1994_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Swaziland ;
    dcterms:date "1994"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :sourceRef "https://scholar.sun.ac.za/bitstream/handle/10019.1/1174/Dlamini.pdf?sequence=1" ;
    :definitionText "(Swaziland 1994) Forest – a vegetation type dominated by trees, which may be pristine rainforest, scrub woodland; Palm savanna or plantation (Wong 2000). According to FAO (1994) Forests are ecosystems with a minimlum of 10% cover of trees or bamboos. https://scholar.sun.ac.za/bitstream/handle/10019.1/1174/Dlamini.pdf?sequence=1" .

:def_Forest_Sweden_2000_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sweden ;
    dcterms:date "2000"^^xsd:gYear ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :areaMin "0.25"^^xsd:decimal ;
    :definitionText "(Sweden 2000) All land with a tree crown cover of more than 20 percent plus have the land with a tree crown cover ranging from 1 percent to 20 percent, and area more than 0.25 ha. For FRA 2000 - Source: UN/ECE 2000 p 87" .

:def_Forest_Sweden_2006_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sweden ;
    dcterms:date "2006"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :heightMin "5.0"^^xsd:decimal ;
    :areaMin "0.5"^^xsd:decimal ;
    :sourceRef "http://unfccc.int/files/national_reports/initial_reports_under_the_kyoto_protocol/application/msword/initial_report_under_the_kyoto_protocol_-_sweden_unfccc_sign.doc" ;
    :definitionText "(Sweden 2006 KP) Cover Min. Area (ha) = 0.5 Min. Crown Cover (%) = 10 Min. Tree Height (m) = 5 Min. Strip Width (m) = 10 http://unfccc.int/files/national_reports/initial_reports_under_the_kyoto_protocol/application/msword/initial_report_under_the_kyoto_protocol_-_sweden_unfccc_sign.doc (2006)" .

:def_Forest_Sweden_2009_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sweden ;
    dcterms:date "2009"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :heightMin "5.0"^^xsd:decimal ;
    :areaMin "0.5"^^xsd:decimal ;
    :sourceRef "http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" ;
    :definitionText "(Sweden 2009 NIR) Crown cover > 10%, tree height > 5m, area > 0.5 ha. http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" .

:def_Forest_Sweden_2009_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sweden ;
    dcterms:date "2009"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :heightMin "5.0"^^xsd:decimal ;
    :sourceRef "http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" ;
    :definitionText "(Sweden 2009) - Types of land under the Forestry Act Determined for the traditional types of land in productive forest, bog, mountain pine forests and other land. Forest land: Land bearing forest or without measures to increase production has the potential to bear forest with a height of 5 m and with a crown cover of at least 10%. Sveriges Lantbruksuniversitet (SLU), 2009. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" .

:def_Forest_Sweden_2010_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Sweden ;
    dcterms:date "2010"^^xsd:gYear ;
    :areaMin "0.25"^^xsd:decimal ;
    :sourceRef "http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" ;
    :definitionText "(Sweden 2010 NFI) Area > 0.25 ha? (Source gives >0.25 m as tree height). http://afoludata.jrc.ec.europa.eu/metaed/project_collection/JRC_54744_Mascaref_Full_Report_for_print.pdf" .

:def_Forest_Switzerland_1997_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Switzerland ;
    dcterms:date "1997"^^xsd:gYear ;
    :canopyThreshold "100.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :definitionText "(Switzerland 1997) - Focuses on growing stock and applies to measurable criteria - width of forest area, crown closure and top height. Width of growing stock with canopy closure = 100% is at least 25 m and with crown closure = 20% at least 50 m. Canopy closure between 20 % and 100 % depending on width of growing stock. Minimum top height 3 m (exceptions afforestation, young growth, mountain alder, mountain pine) (European Communities 1997b - p. 1067)" .

:def_Forest_Switzerland_2006_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Switzerland ;
    dcterms:date "2006"^^xsd:gYear ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :sourceRef "http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" ;
    :definitionText "(Switzerland 2006) -Forest is land covered by trees with a minimum height of 3 m and the minimum width of the tree stand is 50 m. In addition, the tree crowns have to cover at least 20% of the area. Swiss Federal Research Institute (WSL) and Swiss Forest Monitoring, 2006. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf" .

:def_Forest_Switzerland_nd_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Switzerland ;
    :sourceRef "http://www.fao.org/legal/legstud/frmdocrep/41_AK476E.pdf" ;
    :definitionText "(Switzerland) - Any land area covered with forest trees or bushes. http://www.fao.org/legal/legstud/frmdocrep/41_AK476E.pdf" .

:def_Forest_Taiwan_ROC_nd_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Taiwan_ROC ;
    :sourceRef "service@dns.forest.gov.tw" ;
    :definitionText "(Taiwan, ROC) Forest - A plant association predominantly of trees and other woody vegetation ( Bamboo etc. ) in forest land. In Taiwan, the national forests are administrated by Taiwan Forestry Bureau, now subordinated to Council of Agriculture (COA). Source: \"&ordf;L&deg;È&sect;&frac12;service\" service@dns.forest.gov.tw" .

:def_Forest_Tajikistan_1998_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tajikistan ;
    dcterms:date "1998"^^xsd:gYear ;
    :sourceRef "http://www.grida.no/prog/cee/enrin/htmls/tadjik/soe/forest/forest1.htm" ;
    :definitionText "(Tajikistan 1998) Ecosystems, which besides trees include soils, waters, and the multitude of associated animals, plants and micro-organisms. Source: State of the Environment Tajikistan 98 - Forest http://www.grida.no/prog/cee/enrin/htmls/tadjik/soe/forest/forest1.htm" .

:def_Forest_Tajikistan_2010_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tajikistan ;
    dcterms:date "2010"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :sourceRef "http://naturalresources-centralasia.org/assets/files/Forestry%20sector%20analysis%20of%20the%20republic%20of%20Tajikistan%20eng.pdf" ;
    :definitionText "(Tajikistan 2010).forests - an ecosystem with a minimum of 10 percent crown cover of forest trees/or bamboos generally associated with wild flora, fauna, natural regeneration and natural soil conditions that is not subject to agricultural practices. Forestry Code of Tajikistan. http://naturalresources-centralasia.org/assets/files/Forestry%20sector%20analysis%20of%20the%20republic%20of%20Tajikistan%20eng.pdf" .

:def_Forest_Tanzania_1998_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "1998"^^xsd:gYear ;
    :sourceRef "http://www.unep-wcmc.org/forest/restoration/docs/TanzaniaFLR.PDF" ;
    :definitionText "(Tanzania 1998) All land bearing a vegetative association dominated by trees of any size, exploitable or not, and capable of producing wood or other products of exerting influence on the climate or water regime or providing shelter to livestock and wildlife. From: Tanzania Forest policy, Roger Malimbwi, Faculty of Forestry <forestry@sua.ac.tz and (MNRT 1998a) http://www.unep-wcmc.org/forest/restoration/docs/TanzaniaFLR.PDF" .

:def_Forest_Tanzania_2002_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "2002"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :sourceRef "http://www.bunge.go.tz/Polis/PAMS/Docs/14-2002.pdf" ;
    :definitionText "(Tanzania 2002) ''forest'' means an area of land with at least 10% tree crown cover, naturally grown or planted and or 50% or more shrub and tree regeneration cover and includes all forest reserves of whatever kind declared or gazetted under this Act and all plantations; http://www.bunge.go.tz/Polis/PAMS/Docs/14-2002.pdf" .

:def_Forest_Tanzania_2002_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "2002"^^xsd:gYear ;
    :sourceRef "http://books.google.com/books?id=KDcRI1Nj9n0C&pg=PA32&lpg=PA32&dq=having10+percent+tree+cover+or+50+percent+shrub+or+tree+regeneration&source=bl&ots=KcKcFGiIKo&sig=zK4quavMBqFqG0EoOq65imubhq8&hl=en&sa" ;
    :definitionText "(Tanzania 2002) Land having10 percent tree cover or 50 percent shrub or tree regeneration cover, to be designated as a national forest reserve. http://books.google.com/books?id=KDcRI1Nj9n0C&pg=PA32&lpg=PA32&dq=having10+percent+tree+cover+or+50+percent+shrub+or+tree+regeneration&source=bl&ots=KcKcFGiIKo&sig=zK4quavMBqFqG0EoOq65imubhq8&hl=en&sa=X&ei=DNo4T8S2Fqb00gGxipGwAg&ved=0CCUQ6AEwAA#v=onepage&q=having10%20percent%20tree%20cover%20or%2050%20percent%20shrub%20or%20tree%20regeneration&f=false" .

:def_Forest_Tanzania_2002_003
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "2002"^^xsd:gYear ;
    :canopyThreshold "10.0"^^xsd:decimal ;
    :sourceRef "http://www.climate-standards.org/projects/files/tanzania/ufp_mfp_combined_validation_VCS_PDD-1.pdf" ;
    :definitionText "(Tanzania 2002) Under the Forest Act/Law, forests are defined as “an area of land with at least 10% tree crown cover, naturally grown or planted and or 50% or more shrub and tree regeneration cover and includes all forest reserves of whatever kind declared or gazetted under the forest act and all plantations” http://www.climate-standards.org/projects/files/tanzania/ufp_mfp_combined_validation_VCS_PDD-1.pdf" .

:def_Forest_Tanzania_2008_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "2008"^^xsd:gYear ;
    :canopyThreshold "30.0"^^xsd:decimal ;
    :heightMin "3.0"^^xsd:decimal ;
    :areaMin "1.0"^^xsd:decimal ;
    :sourceRef "http://www.climate-standards.org/projects/files/tanzania/ufp_mfp_combined_validation_VCS_PDD-1.pdf" ;
    :definitionText "(Tanzania 2008 KP) a forest is areas with trees of a height of more than 3m, with a crown cover of 30%, covering one hectare of land. (In a communication in October 2008 between Sangito Sumari, Managing Director of GreenResources Ltd and Dr Tango, Ministry of National Resources and Tourism, Tanzania, a definition of 2.5m,30% and 1 ha was indicated). http://www.climate-standards.org/projects/files/tanzania/ufp_mfp_combined_validation_VCS_PDD-1.pdf" .

:def_Forest_Tanzania_2007_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    dcterms:date "2007"^^xsd:gYear ;
    :heightMin "2.0"^^xsd:decimal ;
    :areaMin "1.0"^^xsd:decimal ;
    :sourceRef "https://cdm.unfccc.int/DNA/DNA/allCountriesARInfos.html" ;
    :definitionText "(Tanzania 2007?) Cover = 30%; Area = 1 ha; Tree height = 2 m. https://cdm.unfccc.int/DNA/DNA/allCountriesARInfos.html" .

:def_Forest_Tanzania_nd_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    :canopyThreshold "60.0"^^xsd:decimal ;
    :definitionText "(Tanzania) (Closed Forest) Trees 8 m and canopy closure 60%. No figures given for open forest. Source: ECE-FAO Partnership Programme: Kenya Workshop on Forestry Statistics. Appendix 6." .

:def_Forest_Tanzania_nd_002
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Tanzania ;
    :sourceRef "Forestry <forestry@sua.ac.tz>" ;
    :definitionText "(Tanzania) An area of land covered with trees, grass, and other vegetation but dominated by trees. From: Tanzania Forest policy, Roger Malimbwi, Faculty of Forestry <forestry@sua.ac.tz" .

:def_Forest_Thailand_2001_001
    rdf:type :Definition ;
    :defines :Forest ;
    :hasCategory :LandCover ;
    :hasJurisdictionLevel :National ;
    :appliesIn :Thailand ;
    dcterms:date "2001"^^xsd:gYear ;
    :canopyThreshold "20.0"^^xsd:decimal ;
    :sourceRef "http://www.landcoalition.org/sites/default/files/legacy/legacypdf/08_gtz_land_tenure_systems.pdf" ;
    :definitionText "(Thailand 2001) Closed forest. Forest in which the stand density is greater than 20 percent of the area and tree crowns approach general contact with one another. Open forest. Forest in which the tree canopy layer is discontinuous but covers at least 10 percent of the area and in which the grass layer is continuous. http://www.landcoalition.org/sites/default/files/legacy/legacypdf/08_gtz_land_tenure_systems.pdf" .

:def_Forest_Thailand_2006_001
    rdf:type :Definition ;
    :defines :Forest ;
